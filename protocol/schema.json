{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grammyswitch.local/protocol/schema.json",
  "title": "Vectorworks Voice Copilot Bridge Protocol",
  "description": "Newline-delimited JSON request/response between clients and the bridge (and bridge to plugin).",
  "definitions": {
    "Request": {
      "type": "object",
      "required": ["id", "method"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Client-generated request id; echoed in response."
        },
        "method": {
          "type": "string",
          "enum": ["get_document_info", "get_selection", "create_line", "ping"]
        },
        "params": {
          "type": "object",
          "description": "Method-specific parameters.",
          "default": {}
        }
      }
    },
    "Response": {
      "type": "object",
      "required": ["id", "ok"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "ok": { "type": "boolean" },
        "result": {
          "description": "Present when ok is true.",
          "type": ["object", "null"]
        },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" }
          }
        }
      }
    },
    "CreateLineParams": {
      "type": "object",
      "required": ["x1", "y1", "x2", "y2"],
      "additionalProperties": false,
      "properties": {
        "x1": { "type": "number", "description": "Start X in document units (inches)." },
        "y1": { "type": "number", "description": "Start Y in document units (inches)." },
        "x2": { "type": "number", "description": "End X in document units (inches)." },
        "y2": { "type": "number", "description": "End Y in document units (inches)." }
      }
    },
    "DocumentInfoResult": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "units": { "type": "string", "const": "inches" },
        "units_per_inch": { "type": "number", "const": 1.0 },
        "vw_version": { "type": "string" },
        "mock": { "type": "boolean" }
      }
    },
    "CreateLineResult": {
      "type": "object",
      "properties": {
        "handle": { "type": "string" },
        "x1": { "type": "number" },
        "y1": { "type": "number" },
        "x2": { "type": "number" },
        "y2": { "type": "number" },
        "length_inches": { "type": "number" }
      }
    },
    "SelectionResult": {
      "type": "object",
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "handle": { "type": "string" },
              "type": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
